{
  "compilerOptions": {
    "rootDir": "src",
    "baseUrl": "src",
    "outDir": "dist",

    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "skipLibCheck": true,

    "declaration": true,

    "esModuleInterop": true
  },
  "include": [
    "src/**/*"
  ]
}
